2026-05-08 06:50:11 +00:00: prisma:query SELECT "public"."teacher"."teacher_id", "public"."teacher"."username", "public"."teacher"."password_hash", "public"."teacher"."email", "public"."teacher"."group_id", "public"."teacher"."school_id" FROM "public"."teacher" WHERE "public"."teacher"."username" = $1 LIMIT $2 OFFSET $3
2026-05-08 06:50:12 +00:00: prisma:query 
2026-05-08 06:50:12 +00:00:       SELECT
2026-05-08 06:50:12 +00:00:         p.passage_id,
2026-05-08 06:50:12 +00:00:         p.title,
2026-05-08 06:50:12 +00:00:         count(pr.practice_record_id)           AS attempt_count,
2026-05-08 06:50:12 +00:00:         ROUND(AVG(pr.wrong_count)::numeric, 1) AS avg_wrong_count
2026-05-08 06:50:12 +00:00:       FROM practice_record pr
2026-05-08 06:50:12 +00:00:       JOIN question_registry qr ON qr.question_id = pr.question_id
2026-05-08 06:50:12 +00:00:       JOIN passage           p  ON p.passage_id   = qr.passage_id
2026-05-08 06:50:12 +00:00:       WHERE pr.tested_date >= NOW() - INTERVAL '7 days'
2026-05-08 06:50:12 +00:00:       GROUP BY p.passage_id, p.title
2026-05-08 06:50:12 +00:00:       ORDER BY attempt_count DESC
2026-05-08 06:50:12 +00:00:       LIMIT 5
2026-05-08 06:50:12 +00:00:     
2026-05-08 06:50:12 +00:00: prisma:query 
2026-05-08 06:50:12 +00:00:       SELECT
2026-05-08 06:50:12 +00:00:         pr.practice_record_id,
2026-05-08 06:50:12 +00:00:         pr.tested_date,
2026-05-08 06:50:12 +00:00:         pr.wrong_count,
2026-05-08 06:50:12 +00:00:         pr.duration,
2026-05-08 06:50:12 +00:00:         s.username,
2026-05-08 06:50:12 +00:00:         s.nickname,
2026-05-08 06:50:12 +00:00:         p.title AS passage_title,
2026-05-08 06:50:12 +00:00:         qr.type  AS question_type
2026-05-08 06:50:12 +00:00:       FROM practice_record pr
2026-05-08 06:50:12 +00:00:       JOIN student          s  ON s.student_id   = pr.student_id
2026-05-08 06:50:12 +00:00:       JOIN question_registry qr ON qr.question_id = pr.question_id
2026-05-08 06:50:12 +00:00:       JOIN passage           p  ON p.passage_id   = qr.passage_id
2026-05-08 06:50:12 +00:00:       ORDER BY pr.tested_date DESC
2026-05-08 06:50:12 +00:00:       LIMIT 20
2026-05-08 06:50:12 +00:00:     
2026-05-08 06:50:12 +00:00: prisma:query 
2026-05-08 06:50:12 +00:00:       SELECT
2026-05-08 06:50:12 +00:00:         (SELECT count(*) FROM student)                                                         AS total_students,
2026-05-08 06:50:12 +00:00:         (SELECT count(DISTINCT student_id) FROM practice_record
2026-05-08 06:50:12 +00:00:            WHERE tested_date >= NOW() - INTERVAL '7 days')                                    AS active_this_week,
2026-05-08 06:50:12 +00:00:         (SELECT ROUND(AVG(wrong_count)::numeric, 1)
2026-05-08 06:50:12 +00:00:            FROM practice_record WHERE tested_date >= NOW() - INTERVAL '7 days')               AS avg_wrong_count,
2026-05-08 06:50:12 +00:00:         (SELECT count(*) FROM practice_record
2026-05-08 06:50:12 +00:00:            WHERE tested_date >= NOW() - INTERVAL '7 days')                                    AS total_sessions
2026-05-08 06:50:12 +00:00:     
2026-05-08 06:50:16 +00:00: prisma:query 
2026-05-08 06:50:16 +00:00:         SELECT count(*) FROM student
2026-05-08 06:50:16 +00:00:         WHERE username ILIKE $1 OR COALESCE(nickname, '') ILIKE $2
2026-05-08 06:50:16 +00:00:       
2026-05-08 06:50:16 +00:00: prisma:query SELECT
2026-05-08 06:50:16 +00:00:           s.student_id,
2026-05-08 06:50:16 +00:00:           s.username,
2026-05-08 06:50:16 +00:00:           s.nickname,
2026-05-08 06:50:16 +00:00:           s.register_date,
2026-05-08 06:50:16 +00:00:           p.value                          AS plan,
2026-05-08 06:50:16 +00:00:           count(pr.practice_record_id)     AS total_sessions,
2026-05-08 06:50:16 +00:00:           max(pr.tested_date)              AS last_active
2026-05-08 06:50:16 +00:00:         FROM student s
2026-05-08 06:50:16 +00:00:         LEFT JOIN plan             p  ON p.plan_id    = s.plan_id
2026-05-08 06:50:16 +00:00:         LEFT JOIN practice_record  pr ON pr.student_id = s.student_id
2026-05-08 06:50:16 +00:00:         WHERE s.username ILIKE $1 OR COALESCE(s.nickname, '') ILIKE $1
