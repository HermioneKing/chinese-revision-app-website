2026-05-08 06:51:33 +00:00: prisma:query 
2026-05-08 06:51:33 +00:00:       SELECT passage_id, title, author FROM passage ORDER BY passage_id
2026-05-08 06:51:33 +00:00:     
2026-05-08 06:51:33 +00:00: prisma:query SELECT EXTRACT(HOUR FROM (pr.tested_date + INTERVAL '8 hours'))::int AS hour,
2026-05-08 06:51:33 +00:00:                 count(*) AS attempts
2026-05-08 06:51:33 +00:00:          FROM practice_record pr
2026-05-08 06:51:33 +00:00:          JOIN question_registry qr ON qr.question_id = pr.question_id
2026-05-08 06:51:33 +00:00:          JOIN passage            p  ON p.passage_id   = qr.passage_id
2026-05-08 06:51:33 +00:00:          WHERE pr.tested_date >= NOW() - INTERVAL '30 days' 
2026-05-08 06:51:33 +00:00:          GROUP BY hour
2026-05-08 06:51:33 +00:00:          ORDER BY hour
2026-05-08 06:51:33 +00:00: prisma:query SELECT qr.type,
2026-05-08 06:51:33 +00:00:                 count(pr.practice_record_id)           AS attempts,
2026-05-08 06:51:33 +00:00:                 ROUND(AVG(pr.wrong_count)::numeric, 2) AS avg_wrong
2026-05-08 06:51:33 +00:00:          FROM practice_record pr
2026-05-08 06:51:33 +00:00:          JOIN question_registry qr ON qr.question_id = pr.question_id
2026-05-08 06:51:33 +00:00:          JOIN passage            p  ON p.passage_id   = qr.passage_id
2026-05-08 06:51:33 +00:00:          WHERE pr.tested_date >= NOW() - INTERVAL '30 days' 
2026-05-08 06:51:33 +00:00:          GROUP BY qr.type
2026-05-08 06:51:33 +00:00:          ORDER BY avg_wrong DESC NULLS LAST
2026-05-08 06:51:33 +00:00: prisma:query SELECT EXTRACT(DOW FROM (pr.tested_date + INTERVAL '8 hours'))::int AS dow,
2026-05-08 06:51:33 +00:00:                 count(*) AS attempts
2026-05-08 06:51:33 +00:00:          FROM practice_record pr
2026-05-08 06:51:33 +00:00:          JOIN question_registry qr ON qr.question_id = pr.question_id
2026-05-08 06:51:33 +00:00:          JOIN passage            p  ON p.passage_id   = qr.passage_id
2026-05-08 06:51:33 +00:00:          WHERE pr.tested_date >= NOW() - INTERVAL '30 days' 
2026-05-08 06:51:33 +00:00:          GROUP BY dow
2026-05-08 06:51:33 +00:00:          ORDER BY dow
2026-05-08 06:51:33 +00:00: prisma:query SELECT p.passage_id, p.title, p.author,
2026-05-08 06:51:33 +00:00:                 count(pr.practice_record_id)                                        AS attempts,
2026-05-08 06:51:33 +00:00:                 count(DISTINCT pr.student_id)                                       AS students,
2026-05-08 06:51:33 +00:00:                 ROUND(AVG(pr.wrong_count)::numeric, 1)                             AS avg_wrong,
2026-05-08 06:51:33 +00:00:                 ROUND(100.0 * count(CASE WHEN pr.wrong_count = 0 THEN 1 END)
2026-05-08 06:51:33 +00:00:                       / NULLIF(count(*), 0), 1)                                    AS pct_perfect,
2026-05-08 06:51:33 +00:00:                 ROUND(AVG(pr.duration)::numeric, 0)                                AS avg_duration
2026-05-08 06:51:33 +00:00:          FROM practice_record pr
2026-05-08 06:51:33 +00:00:          JOIN question_registry qr ON qr.question_id = pr.question_id
2026-05-08 06:51:33 +00:00:          JOIN passage            p  ON p.passage_id   = qr.passage_id
2026-05-08 06:51:33 +00:00:          WHERE pr.tested_date >= NOW() - INTERVAL '30 days' 
2026-05-08 06:51:33 +00:00:          GROUP BY p.passage_id, p.title, p.author
2026-05-08 06:51:33 +00:00:          ORDER BY attempts DESC
