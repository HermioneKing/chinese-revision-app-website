// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Student Management Tables
model Plan {
  plan_id   Int      @id @default(autoincrement())
  plan_name String   @db.Text
  function_1 Boolean @default(false)
  function_2 Boolean @default(false)
  students  Student[]

  @@map("plan")
}

model Student {
  student_id    Int     @id @default(autoincrement())
  username      String  @unique @db.Text
  nickname      String? @db.Text
  login_auth    String? @db.Text
  register_date DateTime @default(now()) @db.Date
  plan_id       Int?
  plan          Plan?   @relation(fields: [plan_id], references: [plan_id])
  student_login_google    StudentLoginGoogle?
  student_login_apple     StudentLoginApple?
  student_login_email     StudentLoginEmail?
  QuestionRecord          QuestionRecord[]
  Complete                Complete[]
  ChallengeModeRecord     ChallengeModeRecord?

  @@map("students")
}

model StudentLoginGoogle {
  student_id Int     @id
  google_id  String  @unique @db.Text
  email      String  @db.Text
  student    Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("student_login_google")
}

model StudentLoginApple {
  student_id Int     @id
  apple_id   String  @unique @db.Text
  email      String  @db.Text
  student    Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("student_login_apple")
}

model StudentLoginEmail {
  student_id    Int     @id
  email         String  @unique @db.Text
  password_hash String  @db.Text
  student       Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("student_login_email")
}

// Literature / Question Tables
model Passage {
  passage_id Int     @id
  title      String  @db.VarChar(255)
  author     String? @db.VarChar(255)
  book       String? @db.VarChar(255)
  genre      String  @db.VarChar(100)
  dynasty    String  @db.VarChar(50)
  style      String? @db.VarChar(100)
  order      Int?
  dse        Boolean @default(false)
  taiwan30   Boolean @default(false)
  taiwan15   Boolean @default(false)
  Paragraph  Paragraph[]
  Sentence   Sentence[]
  ShortSentence ShortSentence[]
  Word       Word[]
  MultipleChoice MultipleChoice[]
  Complete   Complete[]
  QuestionRegistry QuestionRegistry[]

  @@map("passage")
}

model QuestionRegistry {
  question_id  String           @id @default(uuid()) @db.Uuid
  passage_id   Int
  source_table String           @db.Text
  type         String           @db.Text
  passage      Passage          @relation(fields: [passage_id], references: [passage_id])
  QuestionRecord QuestionRecord[] @relation("QuestionRecordToRegistry")

  @@map("question_registry")
}

model Paragraph {
  paragraph_id Int      @id @default(autoincrement())
  passage_id   Int?
  value        String?  @db.Text
  order        Int?
  question_id  String   @unique @default(uuid()) @db.Uuid
  passage      Passage? @relation(fields: [passage_id], references: [passage_id])
  Sentence     Sentence[]

  @@map("paragraph")
}

model Sentence {
  sentence_id  Int      @id @default(autoincrement())
  paragraph_id Int?
  value        String?  @db.Text
  translation  String?  @db.Text
  order        Int?
  passage_id   Int?
  question_id  String   @unique @default(uuid()) @db.Uuid
  paragraph    Paragraph? @relation(fields: [paragraph_id], references: [paragraph_id])
  passage      Passage?   @relation(fields: [passage_id], references: [passage_id])
  ShortSentence ShortSentence[]
  TranslationQuestion TranslationQuestion?

  @@map("sentence")
}

model ShortSentence {
  short_sentence_id Int      @id @default(autoincrement())
  sentence_id       Int?
  value             String?  @db.Text
  order             Int?
  passage_id        Int?
  question_id       String   @unique @default(uuid()) @db.Uuid
  sentence          Sentence? @relation(fields: [sentence_id], references: [sentence_id])
  passage           Passage?  @relation(fields: [passage_id], references: [passage_id])
  Word              Word[]

  @@map("short_sentence")
}

model Word {
  word_id           Int      @id @default(autoincrement())
  passage_id        Int?
  short_sentence_id Int?
  order             Int?
  value             String?  @db.Text
  part_of_speech    String?  @db.Text
  meaning_0         String?  @db.Text
  meaning_1         String?  @db.Text
  meaning_2         String?  @db.Text
  tone              String?  @db.Text
  synonym_0         String?  @db.Text
  synonym_1         String?  @db.Text
  synonym_2         String?  @db.Text
  synonym_3         String?  @db.Text
  synonym_4         String?  @db.Text
  synonym_5         String?  @db.Text
  question_id       String?  @default(uuid()) @db.Uuid
  short_sentence    ShortSentence? @relation(fields: [short_sentence_id], references: [short_sentence_id])
  passage           Passage?       @relation(fields: [passage_id], references: [passage_id])

  @@map("word")
}

model MultipleChoice {
  multiple_choice_id Int      @id @default(autoincrement())
  passage_id         Int?
  question           String?  @db.Text
  correct            String?  @db.Text
  wrong_1            String?  @db.Text
  wrong_2            String?  @db.Text
  wrong_3            String?  @db.Text
  correct_explain    String?  @db.Text
  wrong_explain_1    String?  @db.Text
  wrong_explain_2    String?  @db.Text
  wrong_explain_3    String?  @db.Text
  level              Int?
  question_id        String   @unique @default(uuid()) @db.Uuid
  passage            Passage? @relation(fields: [passage_id], references: [passage_id])

  @@map("multiple_choice")
}

model TranslationQuestion {
  sentence_id Int     @id
  question    String? @db.Text
  correct     String? @db.Text
  wrong_1     String? @db.Text
  wrong_2     String? @db.Text
  level       Int?
  question_id String  @unique @default(uuid()) @db.Uuid
  sentence    Sentence @relation(fields: [sentence_id], references: [sentence_id])

  @@map("translation_question")
}

// Records Tables
model QuestionRecord {
  record_id    Int            @id @default(autoincrement())
  questions_id String         @db.Uuid
  student_id   Int
  answer       String?        @db.Text
  is_correct   Boolean
  tested_date  DateTime       @default(now())
  duration     Decimal?       @db.Decimal
  QuestionRegistry QuestionRegistry @relation("QuestionRecordToRegistry", fields: [questions_id], references: [question_id], onDelete: Cascade)
  student      Student        @relation(fields: [student_id], references: [student_id])

  @@map("question_record")
}

model Complete {
  stats_id   Int      @id @default(autoincrement())
  student_id Int
  passage_id Int
  duration   Decimal? @db.Decimal
  asked      Int?
  correct    Int?
  date_time  DateTime @default(now())
  student    Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  passage    Passage  @relation(fields: [passage_id], references: [passage_id], onDelete: Cascade)

  @@map("complete")
}

model ChallengeModeRecord {
  student_id            Int       @id
  best_score            Int?
  best_time_used        Int?
  best_questions_answered Int?    @db.SmallInt
  best_correct_answers  Int?      @db.SmallInt
  best_timestamp        BigInt?
  created_at            DateTime? @db.Timestamptz
  updated_at            DateTime? @db.Timestamptz
  student               Student   @relation(fields: [student_id], references: [student_id])

  @@map("challenge_mode_records")
}

model Grading {
  grade              String   @id @db.Text
  completed_question Float?   @db.DoublePrecision
  correct_percentage Int?

  @@map("grading")
}

model Teacher {
  teacher_id    Int     @id @default(autoincrement())
  username      String  @unique @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  email         String? @db.VarChar(255)
  school_id     Int

  @@map("teacher")
}

// Note: Tables that exist but are not mapped yet:
// - student_info (has different structure, might need separate model)
// - question_count (no primary key, might be a view or special table)
// - dynasty, maxim (not mapped yet)
