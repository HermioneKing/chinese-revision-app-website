# Database Configuration (example: local Docker Postgres on host port 5433)
# Local Node on host uses 127.0.0.1:5433 (mapped from chinese-revision-postgres).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dse12app_demo"
# Backend in Docker same network as Postgres: postgres:5432, e.g. postgresql://postgres:postgres@chinese-revision-postgres:5432/dse12app_demo

# JWT Secret for Authentication
JWT_SECRET="your_jwt_secret_key_here"

# Backend Server Port (host: docker-compose maps backend to this port)
PORT=5007

# Next.js Frontend Port (default is 3000)
# Browser calls (login, home). Must be reachable from the **user's machine** (not 127.0.0.1 if you open the site by server IP).
# Docker publishes frontend on host 3007 → http://127.0.0.1:3007; API on host 5007.
# Examples: http://127.0.0.1:5007/api (browser on same host as Docker), http://YOUR_VPS_IP:5007/api (remote browser).
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:5007/api"
# Server Components / RSC fetch from inside Docker → use internal service URL:
# SERVER_API_BASE_URL=http://backend:5007/api
# Optional: proxy browser /api/* → backend during `next dev`:
# NEXT_BACKEND_ORIGIN=http://127.0.0.1:5007
