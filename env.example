# Database Configuration (example: local Docker Postgres on host port 5433)
# Local Node on host uses 127.0.0.1:5433 (mapped from chinese-revision-postgres).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dse12app_demo"
# Backend in Docker same network as Postgres: postgres:5432, e.g. postgresql://postgres:postgres@chinese-revision-postgres:5432/dse12app_demo

# JWT Secret for Authentication
JWT_SECRET="your_jwt_secret_key_here"

# Backend Server Port (host: docker-compose maps backend to this port)
PORT=5007

# Next.js Frontend Port (default is 3000)
#
# Browser → API (use the SAME approach on laptop and VPS):
# - Leave NEXT_PUBLIC_API_BASE_URL empty. The app calls /api/... on the same host as the page.
# - docker-compose sets NEXT_BACKEND_ORIGIN=http://backend:5007 so Next rewrites /api/* to the backend.
# - Local Docker: open http://localhost:3007 only — no need to hit :5007 from the browser.
# - VPS: nginx should proxy the whole site (/) to Next on host port 3007; Next forwards /api to the backend.
#   Do NOT set NEXT_PUBLIC_API_BASE_URL to http://VPS:5007 behind HTTPS (mixed content).
# - Only if you run `next dev` on the host (no Docker frontend): set in .env.local
#   NEXT_BACKEND_ORIGIN=http://127.0.0.1:5007
#   and run the backend on the host so /api rewrites work.
NEXT_PUBLIC_API_BASE_URL=
# Server Components / RSC fetch from inside Docker → compose sets this; for host-only dev:
# SERVER_API_BASE_URL=http://backend:5007/api
